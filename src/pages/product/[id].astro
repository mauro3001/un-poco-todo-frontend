---
import Layout from "@layouts/Layout.astro";
import { getProductById, getTags } from "@lib/api";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

const [product, tags] = await Promise.all([getProductById(id), getTags()]);

if (!product) {
  return Astro.redirect("/404");
}

// Map Notion colors to Hex
const colorMap: Record<string, string> = {
  default: "#787774",
  gray: "#9B9A97",
  brown: "#64473A",
  orange: "#D9730D",
  yellow: "#DFAB01",
  green: "#0F7B6C",
  blue: "#0B6E99",
  purple: "#6940A5",
  pink: "#AD1A72",
  red: "#E03E3E",
};

const tagColorMap = new Map(tags.map((t) => [t.name, colorMap[t.color]]));

const formattedPrice = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
}).format(product.price);
---

<Layout title={product.title}>
  <main class="max-w-7xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div class="aspect-[4/5] bg-[#f0f0f0] overflow-hidden">
        <img
          transition:name={`img-${product.id}`}
          src={product.imageUrl || "/placeholder.png"}
          alt={product.title}
          class="w-full h-full object-cover opacity-90 transition-opacity hover:opacity-100"
        />
      </div>

      <div class="flex flex-col space-y-8 font-['Inter'] text-[#1a1a1a]">
        <div class="space-y-2">
          <h1
            transition:name={`text-${product.id}`}
            class="text-4xl md:text-6xl font-black tracking-tight uppercase leading-none"
          >
            {product.title}
          </h1>
          <p class="text-3xl font-bold tracking-tight">
            {formattedPrice}
          </p>
        </div>

        <div class="w-full h-[1px] bg-black/30"></div>

        <div class="space-y-3">
          <p class="text-[20px] leading-relaxed opacity-80 max-w-md">
            {product.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {
              product.tags?.map((tag: string) => {
                const color = tagColorMap.get(tag) || colorMap.default;
                return (
                  <span
                    class="flex items-center gap-2 text-[10px] tracking-[0.1em] uppercase border border-black/10 px-3 py-1.5 opacity-60 hover:opacity-100 cursor-pointer transition-all duration-300 hover:border-[var(--tag-color)] hover:shadow-[0_0_12px_rgba(0,0,0,0.05)] hover:shadow-[var(--tag-color)/20] group/tag"
                    style={`--tag-color: ${color};`}
                  >
                    <span
                      class="w-1.5 h-1.5 rounded-full transition-transform group-hover/tag:scale-125"
                      style={`background-color: ${color}`}
                    />
                    {tag}
                  </span>
                );
              })
            }
          </div>
        </div>

        <div class="pt-2">
          <a
            href={`https://wa.me/573143504223?text=${encodeURIComponent(`Hola! Estoy interesado en el producto: ${product.title}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 w-full md:w-auto bg-black text-white px-12 py-5 text-[13px] font-bold tracking-[0.2em] uppercase hover:bg-black/80 transition-all hover:scale-[1.02] active:scale-[0.98]"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path>
            </svg>
            Realizar Compra
          </a>
        </div>

        <div class="pt-5 space-y-4">
          <details class="group border-t border-black/5 pt-4">
            <summary
              class="list-none flex justify-between items-center cursor-pointer text-[11px] tracking-[0.2em] uppercase font-bold opacity-80 hover:opacity-100"
            >
              Detalles del Producto
              <span class="group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <div class="pt-4 text-[13px] opacity-50 leading-relaxed max-w-md">
              Productos naturistas y medicinales con un enfoque en la pureza y
              el detalle.
            </div>
          </details>

          <details class="group border-t border-black/5 pt-4">
            <summary
              class="list-none flex justify-between items-center cursor-pointer text-[11px] tracking-[0.2em] uppercase font-bold opacity-80 hover:opacity-100"
            >
              Envío y Devoluciones
              <span class="group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <div class="pt-4 text-[13px] opacity-50 leading-relaxed max-w-md">
              Realizamos envíos a toda Colombia. El costo del envío debe ser
              asumido por el comprador y puede variar según la ciudad o
              ubicación de entrega. Nuestro equipo se encargará de coordinar el
              envío de manera rápida y segura una vez confirmada la compra.
            </div>
          </details>
        </div>
      </div>
    </div>
  </main>
</Layout>
