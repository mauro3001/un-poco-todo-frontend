---
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getTags } from "@lib/api";

const tags = await getTags();

interface Props {
  title: string;
}

const { title } = Astro.props;

// Map Notion colors to Hex
const colorMap: Record<string, string> = {
  default: "#787774",
  gray: "#9B9A97",
  brown: "#64473A",
  orange: "#D9730D",
  yellow: "#DFAB01",
  green: "#0F7B6C",
  blue: "#0B6E99",
  purple: "#6940A5",
  pink: "#AD1A72",
  red: "#E03E3E",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | UN POCO DE TODO</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body
    class="bg-[#fcfcfc] text-[#1a1a1a] selection:bg-black selection:text-white"
  >
    <div
      id="progress-bar"
      class="fixed top-0 left-0 h-[4px] bg-black z-[100] transition-all duration-300 w-0"
    >
    </div>

    <header
      class="fixed top-0 left-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-black/5"
    >
      <nav
        class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between font-['Inter']"
      >
        <div class="hidden md:flex items-center gap-8">
          <div class="relative group">
            <button
              class="flex items-center gap-2 text-[12px] font-bold tracking-[0.2em] uppercase hover:opacity-50 transition-opacity"
            >
              CATEGORIAS
              <svg
                class="w-2.5 h-2.5 opacity-40 transition-transform group-hover:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div
              class="absolute top-full left-0 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0"
            >
              <div
                class="bg-white/95 border border-black/10 shadow-2xl backdrop-blur-xl min-w-[220px]"
              >
                <div class="py-3 px-2">
                  {
                    tags.map((tag) => (
                      <a
                        href={`/?tag=${tag.name}`}
                        class="flex items-center gap-3 px-6 py-3 text-[10px] tracking-[0.1em] uppercase font-bold hover:bg-black/5 transition-colors group/item"
                      >
                        <span
                          class="w-2 h-2 rounded-full ring-4 ring-black/5"
                          style={`background-color: ${colorMap[tag.color] || colorMap.default}`}
                        />
                        <span class="text-[#1a1a1a] group-hover/item:translate-x-1 transition-transform">
                          {tag.name}
                        </span>
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <a
          href="/"
          class="absolute left-1/2 -translate-x-1/2 text-lg font-black tracking-[0.3em] uppercase text-[#1a1a1a]"
        >
          Un Poco de Todo
        </a>

        <div
          class="flex items-center gap-6 text-[12px] font-bold tracking-[0.2em] uppercase relative"
        >
          <!-- Search UI -->
          <div
            id="search-container"
            class="flex items-center gap-2 transition-all duration-300"
          >
            <button
              id="search-toggle"
              class="hover:opacity-50 transition-opacity focus:outline-none flex items-center"
            >
              BUSCAR
            </button>
            <div
              id="search-input-wrapper"
              class="absolute right-full mr-4 opacity-0 invisible translate-x-4 transition-all duration-300 flex items-center bg-white border-b border-black/20"
            >
              <input
                type="text"
                id="search-input"
                placeholder="ESCRIBE AQUÍ..."
                class="bg-transparent border-none focus:ring-0 text-[10px] py-1 w-[200px] uppercase placeholder:opacity-100"
              />
              <button
                id="search-close"
                class="p-1 hover:opacity-100 opacity-40 transition-opacity"
              >
                <svg
                  class="w-2.5 h-2.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <div class="pt-20 pb-16 text-[#1a1a1a]">
      <slot />
    </div>

    <footer class="border-t border-black/3 py-12 px-6 text-center">
      <p class="text-[10px] tracking-[0.2em] uppercase opacity-70">
        &copy; 2026 Un Poco de Todo. Todos los derechos reservados.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --font-inter: "Inter", system-ui, sans-serif;
  }

  html {
    font-family: var(--font-inter);
    background-color: #fcfcfc;
    color: #1a1a1a;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  /* Custom Scrollbar for Luxury Feel */
  ::-webkit-scrollbar {
    width: 4px;
  }
  ::-webkit-scrollbar-track {
    background: #fcfcfc;
  }
  ::-webkit-scrollbar-thumb {
    background: #ddd;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #bbb;
  }
</style>

<script>
  document.addEventListener("astro:before-preparation", () => {
    const bar = document.getElementById("progress-bar");
    if (bar) {
      bar.style.width = "30%";
      bar.style.opacity = "1";
    }
  });

  document.addEventListener("astro:after-preparation", () => {
    const bar = document.getElementById("progress-bar");
    if (bar) {
      bar.style.width = "100%";
    }
  });

  document.addEventListener("astro:after-swap", () => {
    const bar = document.getElementById("progress-bar");
    if (bar) {
      bar.style.opacity = "0";
      setTimeout(() => {
        bar.style.width = "0%";
      }, 300);
    }
  });

  // Search Logic
  const initSearch = () => {
    const toggle = document.getElementById("search-toggle");
    const close = document.getElementById("search-close");
    const wrapper = document.getElementById("search-input-wrapper");
    const input = document.getElementById("search-input") as HTMLInputElement;

    if (!toggle || !close || !wrapper || !input) return;

    toggle.addEventListener("click", () => {
      wrapper.classList.remove("opacity-0", "invisible", "translate-x-4");
      wrapper.classList.add("opacity-100", "visible", "translate-x-0");
      toggle.classList.add("opacity-0", "invisible");
      input.focus();
    });

    close.addEventListener("click", () => {
      wrapper.classList.add("opacity-0", "invisible", "translate-x-4");
      wrapper.classList.remove("opacity-100", "visible", "translate-x-0");
      toggle.classList.remove("opacity-0", "invisible");
      input.value = "";
    });

    input.addEventListener("keypress", (e) => {
      if (e.key === "Enter") {
        const query = input.value.trim();
        if (query) {
          window.location.href = `/?search=${encodeURIComponent(query)}`;
        }
      }
    });

    // Close on escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !wrapper.classList.contains("invisible")) {
        close.click();
      }
    });
  };

  initSearch();
  document.addEventListener("astro:page-load", initSearch);
</script>
