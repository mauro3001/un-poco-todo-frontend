---
import type { Product } from "@lib/api";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { id, title, price, description, imageUrl, tags } = product;

// Format price
const formattedPrice = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
}).format(price);

// Using the first tag
const collection = tags.length > 0 ? tags[0] : "Essential";

const borderColors = [
  "#6B6B6B", // Graphite
  "#6E8B6B", // Deep Sage
  "#B26A2E", // Burnt Ochre
  "#8A9A5B", // Moss Olive
  "#A3A86B", // Dusty Lime
  "#C2A878", // Vintage Sand
  "#A47148", // Raw Terra
  "#7A7A68", // Gray Stone
  "#556B2F", // Dark Olive Green
  "#8B4513", // Saddle Brown
  "#2F4F4F", // Dark Slate Gray
  "#BC8F8F", // Rosy Brown
  "#483D8B", // Dark Slate Blue (muted)
  "#8FBC8F", // Dark Sea Green
  "#CD853F", // Peru (warm wood)
  "#4682B4", // Steel Blue (muted)
  "#966953", // Walnut
  "#5D4037", // Coffee
  "#607D8B", // Blue Gray
  "#526D82", // Slate
  "#9DB2BF", // Light Slate (muted)
  "#435334", // Forest
  "#9EB384", // Pale Leaf
  "#CEDEBD", // Mint Slate
  "#FAF1E4", // Off White Stone
  "#3C4048", // Dark Resin
];
const randomBorder = borderColors[(Math.random() * borderColors.length) | 0];

// Truncate description to 30 words
const truncateDescription = (text: string, limit: number) => {
  const words = text.split(/\s+/);
  if (words.length > limit) {
    return words.slice(0, limit).join(" ") + "...";
  }
  return text;
};

const shortDescription = truncateDescription(description, 30);
---

<div class="group flex flex-col h-full bg-white transition-all duration-300">
  <a
    href={`/product/${id}`}
    class="flex-grow active:scale-[0.98] transition-transform duration-200"
  >
    <div class="relative aspect-[4/5] overflow-hidden bg-[#f3f3f3] mb-6">
      <img
        transition:name={`img-${id}`}
        src={imageUrl || "/placeholder.png"}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90 group-hover:opacity-100"
      />

      <div
        class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
      >
        <span
          class="text-[10px] tracking-[0.2em] font-bold uppercase border border-black/10 px-4 py-2 backdrop-blur-sm text-[#1a1a1a]"
        >
          Ver Detalles
        </span>
      </div>
    </div>

    <div class="flex flex-col space-y-3 font-['Inter'] px-1">
      <div class="flex">
        <span
          class="text-[10px] tracking-[0.2em] font-bold uppercase py-1 px-3 border-2"
          style={`border-color: ${randomBorder}; color: ${randomBorder};`}
        >
          {collection}
        </span>
      </div>

      <div class="space-y-2">
        <div class="flex justify-between items-start gap-4">
          <h3
            transition:name={`text-${id}`}
            class="text-[17px] font-black tracking-tight uppercase leading-[1.1] text-[#1a1a1a] transition-colors duration-300 group-hover:text-[var(--hover-color)]"
            style={`--hover-color: ${randomBorder};`}
          >
            {title}
          </h3>

          <span
            class="text-[16px] font-extrabold tracking-tight whitespace-nowrap text-[#1a1a1a]"
          >
            {formattedPrice}
          </span>
        </div>

        <p
          class="text-[16px] leading-[1.4] text-[#1a1a1a]/60 line-clamp-2 font-serif font-semibold"
        >
          {shortDescription}
        </p>
      </div>
    </div>
  </a>

  <div class="pt-2 px-1">
    <a
      href={`https://wa.me/573143504223?text=${encodeURIComponent(`Hola! Estoy interesado en el producto: ${title}`)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full bg-black text-white py-3 text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-black/80 transition-all active:scale-95"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
        ></path>
      </svg>
      Realizar Compra
    </a>
  </div>
</div>
